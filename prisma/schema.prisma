generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Link {
  id          Int      @id @default(autoincrement())
  title       String
  url         String?
  description String?
  icon        String   @default("globe")
  category    String   @default("General")
  color       String   @default("#3b82f6")
  link_type   String   @default("web")
  file_url    String?
  file_name   String?
  file_type   String?
  thumbnail   String?
  is_favorite Boolean  @default(false)
  click_count Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Category {
  id         Int      @id @default(autoincrement())
  name       String
  icon       String?
  color      String   @default("#3b82f6")
  sort_order Int      @default(0)
  created_at DateTime @default(now())
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String?
  updated_at DateTime @updatedAt
}

model CalendarEvent {
  id          Int      @id @default(autoincrement())
  title       String
  date        String   // format: YYYY-MM-DD
  color       String   @default("#00ff88")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Contract {
  id              String   @id @default(cuid())
  contractNumber  String   @unique
  agentCode       String
  agentName       String
  position        String   @default("")
  ban             String   @default("")
  nhom            String   @default("")
  maNhom          String   @default("")
  leaderAgentCode String   @default("")
  recruiterCode   String   @default("")
  startDate       DateTime?
  effectiveDate   DateTime
  issueDate       DateTime
  fyp             Float    @default(0)
  afyp            Float    @default(0)
  tinhLuot        Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Contest {
  id              String   @id @default(cuid())
  title           String
  startDate       DateTime
  endDate         DateTime
  issueDate       DateTime?
  conditionType   String   @default("per_contract")
  targetType      String   @default("tvv")
  bonusTiers      String
  posterUrl       String   @default("")
  participants    String   @default("[]")
  usePhase2       Boolean  @default(false)
  phase2StartDate DateTime?
  phase2EndDate   DateTime?
  bonusTiers2     String   @default("[]")
  useSecondaryCondition Boolean @default(false)
  secondaryAFYPMin Float  @default(0)
  secondaryIPMin   Float  @default(0)
  hideNotAchieved  Boolean @default(false)
  useTVVmFilter    Boolean @default(false)
  includeOwnNYD    Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
