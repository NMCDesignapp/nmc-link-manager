// Use this schema for Vercel deployment with Neon PostgreSQL
// Rename this file to schema.prisma and replace the existing one

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Link {
  id          Int      @id @default(autoincrement())
  title       String
  url         String?
  description String?
  icon        String   @default("globe")
  category    String   @default("General")
  color       String   @default("#3b82f6")
  link_type   String   @default("web")
  file_url    String?
  file_name   String?
  file_type   String?
  thumbnail   String?
  is_favorite Boolean  @default(false)
  click_count Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
}

model Category {
  id         Int      @id @default(autoincrement())
  name       String
  icon       String?
  color      String   @default("#3b82f6")
  sort_order Int      @default(0)
  created_at DateTime @default(now())
}

model Setting {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  value      String?
  updated_at DateTime @updatedAt
}
